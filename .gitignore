# Face images and any derived data must never be committed.
data/*
# EXCEPT population reference statistics (D1 stage B). These are aggregate
# median/MAD per (concern, ROI) -- no images, nothing identifiable -- and they
# determine every user-facing severity, so they must be versioned and auditable.
# Image patterns below still apply inside this tree.
!data/reference/

# ...but never an image, anywhere under data/, whatever the exception above allows.
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.heic
data/**/*.webp
*.jpg
*.jpeg
*.png
*.heic
*.mp4
!docs/**/*.png
!tests/fixtures/synthetic_*.png

# Model weights: nothing untracked may enter the repo (licensing gate).
*.pt
*.pth
*.onnx
*.tflite
# MediaPipe bundles: cleared by license, still never vendored. NOTE: .gitignore has
# no inline comments -- a trailing '# ...' becomes part of the pattern and matches
# nothing. Keep comments on their own line.
*.task
*.h5
*.pb
weights/
checkpoints/

# Debug output
debug_*.png
*_overlay.png
validation_runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets
.env
.env.*
kaggle.json

# Cohort collection exports (manifest/contacts spreadsheets, real emails + subject data)
*.xlsx
SkinAnalysis-Cohort*/
